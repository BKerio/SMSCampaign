# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS - comma-separated list of allowed origins (use * for open access in dev)
CORS_ORIGIN=*

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Bulk SMS gateway (Advanta/QuickSMS) - required for sending campaigns.
# Members/groups still work without these set; POST /campaigns will return a
# 400 until every one of these is filled in.
ADVANTA_SMS_URL=
ADVANTA_API_KEY=
ADVANTA_PARTNER_ID=
ADVANTA_SHORTCODE=
